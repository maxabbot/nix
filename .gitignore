# Nix build outputs
result
result-*

# Nix flake lock backup
flake.lock.bak

# direnv
.direnv

# Local secrets / credentials — never commit
github_pat
*.iso

# Claude Code per-machine permission approvals
.claude/settings.local.json

# ── Secrets ──────────────────────────────────────────────────────────────────
# secrets/*.yaml is sops-encrypted and IS committed. These patterns stop the
# plaintext forms (age private keys, decrypted copies) being staged by accident.
keys.txt
key.txt
*.agekey
.sops-decrypted-*

# Per-host age keys staged before they're copied onto each machine (PRIVATE).
# Delete a host's directory once its key is installed and a rebuild decrypts.
.bootstrap/
